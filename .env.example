# Docker Compose (local Postgres and Valkey)
POSTGRES_USER=clientry
POSTGRES_PASSWORD=clientry
POSTGRES_DB=clientry
POSTGRES_PORT=5432
VALKEY_PORT=6379

# API (apps/api); 127.0.0.1 rather than localhost, since Compose binds IPv4 only
NODE_ENV=development
PORT=4000
LOG_LEVEL=info
DATABASE_URL=postgresql://clientry:clientry@127.0.0.1:5432/clientry
REDIS_URL=redis://127.0.0.1:6379

# Auth: generate a key pair with `pnpm --filter @clientry/api jwt:keygen`; never commit a key
JWT_PRIVATE_KEY=
# Web app and Swagger UI on the API's own origin
TRUSTED_ORIGINS=http://localhost:3000,http://localhost:4000
# Proxies in front of the API whose X-Forwarded-For is trusted
TRUST_PROXY_HOPS=0
