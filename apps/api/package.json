{
  "name": "@clientry/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "files": [
    "dist",
    "prisma",
    "prisma.config.ts"
  ],
  "scripts": {
    "dev": "nest start --watch --env-file ../../.env",
    "build": "nest build",
    "start": "node dist/main.js",
    "generate": "prisma generate",
    "db:migrate": "prisma migrate dev && prisma generate",
    "db:deploy": "prisma migrate deploy",
    "jwt:keygen": "node scripts/generate-jwt-keys.ts",
    "lint": "eslint . --max-warnings 0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:unit": "vitest run --project unit"
  },
  "dependencies": {
    "@clientry/shared": "workspace:*",
    "@nestjs/common": "12.1.2",
    "@nestjs/core": "12.1.2",
    "@nestjs/platform-express": "12.1.2",
    "@nestjs/swagger": "12.0.2",
    "@nestjs/throttler": "6.7.1",
    "@node-rs/argon2": "2.2.1",
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "cookie-parser": "1.4.7",
    "ioredis": "6.0.0",
    "jose": "6.2.12",
    "nestjs-pino": "5.2.1",
    "pino": "10.3.1",
    "pino-http": "11.0.0",
    "prisma": "7.10.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@clientry/eslint-config": "workspace:*",
    "@clientry/typescript-config": "workspace:*",
    "@nestjs/cli": "12.0.8",
    "@nestjs/testing": "12.1.2",
    "@swc/cli": "0.8.1",
    "@swc/core": "1.16.13",
    "@testcontainers/postgresql": "12.2.0",
    "@testcontainers/valkey": "12.2.0",
    "@types/cookie-parser": "1.4.10",
    "@types/express": "5.0.6",
    "@types/node": "24.19.1",
    "@types/supertest": "7.2.1",
    "eslint": "10.11.0",
    "pino-pretty": "13.1.3",
    "supertest": "7.3.0",
    "typescript": "6.0.3",
    "unplugin-swc": "2.0.0",
    "vite": "8.3.1",
    "vitest": "5.0.2"
  }
}
