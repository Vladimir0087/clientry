generator client {
  provider            = "prisma-client"
  output              = "../src/infra/prisma/generated"
  moduleFormat        = "esm"
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

enum MemberRole {
  owner
  manager

  @@map("member_role")
}

enum ClientSource {
  website
  telegram
  referral
  other

  @@map("client_source")
}

enum StageKind {
  open
  won
  lost

  @@map("stage_kind")
}

enum Currency {
  USD
  EUR
  PLN
  BYN
  RUB

  @@map("currency")
}

enum ActivityType {
  deal_created
  deal_moved
  deal_updated
  deal_deleted
  deal_restored
  client_created
  task_created
  task_completed

  @@map("activity_type")
}

enum NotificationType {
  task_reminder

  @@map("notification_type")
}

model User {
  id             String         @id @default(uuid(7)) @db.Uuid
  email          String         @unique
  passwordHash   String         @map("password_hash")
  name           String
  createdAt      DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime       @updatedAt @map("updated_at") @db.Timestamptz(3)
  membership     Membership?
  sessions       Session[]
  clients        Client[]
  createdDeals   Deal[]         @relation("DealCreatedBy")
  assignedDeals  Deal[]         @relation("DealAssignee")
  activities     Activity[]
  createdTasks   Task[]         @relation("TaskCreatedBy")
  assignedTasks  Task[]         @relation("TaskAssignee")
  notifications  Notification[]
  createdInvites Invite[]       @relation("InviteCreatedBy")
  usedInvites    Invite[]       @relation("InviteUsedBy")

  @@map("users")
}

model Workspace {
  id            String         @id @default(uuid(7)) @db.Uuid
  name          String
  // Set only by the demo module, on its one workspace.
  isDemo        Boolean        @default(false) @map("is_demo")
  createdAt     DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime       @updatedAt @map("updated_at") @db.Timestamptz(3)
  memberships   Membership[]
  stages        Stage[]
  clients       Client[]
  deals         Deal[]
  activities    Activity[]
  tasks         Task[]
  notifications Notification[]
  invites       Invite[]

  @@map("workspaces")
}

model Membership {
  id          String     @id @default(uuid(7)) @db.Uuid
  userId      String     @unique @map("user_id") @db.Uuid
  workspaceId String     @map("workspace_id") @db.Uuid
  role        MemberRole
  createdAt   DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime   @updatedAt @map("updated_at") @db.Timestamptz(3)
  user        User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspace   Workspace  @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
  @@map("memberships")
}

// No role: every invite joins as a manager.
model Invite {
  id          String    @id @default(uuid(7)) @db.Uuid
  workspaceId String    @map("workspace_id") @db.Uuid
  createdById String    @map("created_by_id") @db.Uuid
  tokenHash   Bytes     @unique @map("token_hash")
  expiresAt   DateTime  @map("expires_at") @db.Timestamptz(3)
  usedAt      DateTime? @map("used_at") @db.Timestamptz(3)
  usedById    String?   @map("used_by_id") @db.Uuid
  revokedAt   DateTime? @map("revoked_at") @db.Timestamptz(3)
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  createdBy   User      @relation("InviteCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  usedBy      User?     @relation("InviteUsedBy", fields: [usedById], references: [id], onDelete: Restrict)

  @@index([workspaceId, createdAt])
  @@index([createdById])
  @@index([usedById])
  @@map("invites")
}

model Stage {
  id          String    @id @default(uuid(7)) @db.Uuid
  workspaceId String    @map("workspace_id") @db.Uuid
  name        String
  position    Int
  kind        StageKind
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  deals       Deal[]

  @@index([workspaceId, position])
  @@map("stages")
}

model Session {
  id            String         @id @default(uuid(7)) @db.Uuid
  userId        String         @map("user_id") @db.Uuid
  expiresAt     DateTime       @map("expires_at") @db.Timestamptz(3)
  revokedAt     DateTime?      @map("revoked_at") @db.Timestamptz(3)
  createdAt     DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  refreshTokens RefreshToken[]

  @@index([userId])
  @@map("sessions")
}

model RefreshToken {
  id        String    @id @default(uuid(7)) @db.Uuid
  sessionId String    @map("session_id") @db.Uuid
  tokenHash Bytes     @unique @map("token_hash")
  rotatedAt DateTime? @map("rotated_at") @db.Timestamptz(3)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  session   Session   @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId])
  @@map("refresh_tokens")
}

model Client {
  id          String        @id @default(uuid(7)) @db.Uuid
  workspaceId String        @map("workspace_id") @db.Uuid
  createdById String        @map("created_by_id") @db.Uuid
  // The migration gives this column the "und-x-icu" collation, which Prisma does not model.
  name        String
  company     String?
  email       String?
  phone       String?
  source      ClientSource?
  notes       String?
  tags        String[]      @default([])
  createdAt   DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime      @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt   DateTime?     @map("deleted_at") @db.Timestamptz(3)
  workspace   Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  createdBy   User          @relation(fields: [createdById], references: [id], onDelete: Restrict)
  deals       Deal[]
  tasks       Task[]
  activities  Activity[]

  @@index([workspaceId, createdAt, id])
  @@index([workspaceId, name, id])
  @@index([createdById])
  @@index([tags], type: Gin)
  @@index([name(ops: raw("gin_trgm_ops"))], type: Gin)
  @@index([company(ops: raw("gin_trgm_ops"))], type: Gin)
  @@index([email(ops: raw("gin_trgm_ops"))], type: Gin)
  @@index([phone(ops: raw("gin_trgm_ops"))], type: Gin)
  @@map("clients")
}

model Deal {
  id          String     @id @default(uuid(7)) @db.Uuid
  workspaceId String     @map("workspace_id") @db.Uuid
  clientId    String     @map("client_id") @db.Uuid
  stageId     String     @map("stage_id") @db.Uuid
  assigneeId  String     @map("assignee_id") @db.Uuid
  createdById String     @map("created_by_id") @db.Uuid
  title       String
  amount      BigInt
  currency    Currency
  // The migration gives this column the "C" collation, which Prisma does not model.
  position    String
  version     Int        @default(1)
  closedAt    DateTime?  @map("closed_at") @db.Timestamptz(3)
  createdAt   DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime   @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt   DateTime?  @map("deleted_at") @db.Timestamptz(3)
  workspace   Workspace  @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  client      Client     @relation(fields: [clientId], references: [id], onDelete: NoAction)
  stage       Stage      @relation(fields: [stageId], references: [id], onDelete: NoAction)
  assignee    User       @relation("DealAssignee", fields: [assigneeId], references: [id], onDelete: Restrict)
  createdBy   User       @relation("DealCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  activities  Activity[]
  tasks       Task[]

  // Led by stageId: a stage delete checks its foreign key through it.
  @@index([stageId, position, id])
  @@index([workspaceId, stageId, closedAt, id])
  @@index([clientId, createdAt])
  @@map("deals")
}

model Activity {
  id          String       @id @default(uuid(7)) @db.Uuid
  workspaceId String       @map("workspace_id") @db.Uuid
  // Exactly one subject is set, fixed by the type; ActivityLog is the one writer and the only gate.
  dealId      String?      @map("deal_id") @db.Uuid
  clientId    String?      @map("client_id") @db.Uuid
  taskId      String?      @map("task_id") @db.Uuid
  actorId     String       @map("actor_id") @db.Uuid
  type        ActivityType
  payload     Json
  createdAt   DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  workspace   Workspace    @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  deal        Deal?        @relation(fields: [dealId], references: [id], onDelete: NoAction)
  client      Client?      @relation(fields: [clientId], references: [id], onDelete: NoAction)
  task        Task?        @relation(fields: [taskId], references: [id], onDelete: NoAction)
  actor       User         @relation(fields: [actorId], references: [id], onDelete: Restrict)

  @@index([dealId, createdAt, id])
  @@index([workspaceId, createdAt, id])
  @@map("activities")
}

model Task {
  id             String         @id @default(uuid(7)) @db.Uuid
  workspaceId    String         @map("workspace_id") @db.Uuid
  createdById    String         @map("created_by_id") @db.Uuid
  assigneeId     String         @map("assignee_id") @db.Uuid
  // At most one of clientId and dealId is set; the request schemas are the only gate.
  clientId       String?        @map("client_id") @db.Uuid
  dealId         String?        @map("deal_id") @db.Uuid
  title          String
  dueAt          DateTime       @map("due_at") @db.Timestamptz(3)
  remindAt       DateTime?      @map("remind_at") @db.Timestamptz(3)
  reminderSentAt DateTime?      @map("reminder_sent_at") @db.Timestamptz(3)
  doneAt         DateTime?      @map("done_at") @db.Timestamptz(3)
  createdAt      DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime       @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt      DateTime?      @map("deleted_at") @db.Timestamptz(3)
  workspace      Workspace      @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  createdBy      User           @relation("TaskCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  assignee       User           @relation("TaskAssignee", fields: [assigneeId], references: [id], onDelete: Restrict)
  client         Client?        @relation(fields: [clientId], references: [id], onDelete: NoAction)
  deal           Deal?          @relation(fields: [dealId], references: [id], onDelete: NoAction)
  notifications  Notification[]
  activities     Activity[]

  // Open lists read done_at IS NULL forwards, done lists read the same index backwards.
  @@index([workspaceId, doneAt, dueAt, id])
  @@index([assigneeId, doneAt, dueAt, id])
  @@index([clientId, dueAt])
  @@index([dealId, dueAt])
  @@index([remindAt])
  @@map("tasks")
}

model Notification {
  id          String           @id @default(uuid(7)) @db.Uuid
  workspaceId String           @map("workspace_id") @db.Uuid
  userId      String           @map("user_id") @db.Uuid
  taskId      String?          @map("task_id") @db.Uuid
  type        NotificationType
  payload     Json
  readAt      DateTime?        @map("read_at") @db.Timestamptz(3)
  createdAt   DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  workspace   Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user        User             @relation(fields: [userId], references: [id], onDelete: Restrict)
  task        Task?            @relation(fields: [taskId], references: [id], onDelete: NoAction)

  @@index([userId, createdAt, id])
  // workspace_id last: the unread count filters by both and stays an index-only scan.
  @@index([userId, readAt, workspaceId])
  @@map("notifications")
}
