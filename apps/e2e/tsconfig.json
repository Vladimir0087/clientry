{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": "@clientry/typescript-config/base.json",
  "compilerOptions": {
    "module": "nodenext",
    "moduleResolution": "nodenext",
    // Pages run in the browser through page.evaluate and locator callbacks.
    "lib": ["es2025", "dom"],
    "noEmit": true
  },
  "include": ["**/*.ts"],
  "exclude": ["node_modules", "playwright-report", "test-results"]
}
