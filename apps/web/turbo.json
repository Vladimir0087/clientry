{
  "$schema": "https://turborepo.dev/schema.json",
  "extends": ["//"],
  "tasks": {
    "typegen": {
      "dependsOn": ["^build"],
      "env": ["API_URL", "JWT_PUBLIC_KEY"],
      "outputs": ["next-env.d.ts", ".next/types/**"]
    },
    "build": {
      // next build wipes .next/types, which typegen writes and lint and typecheck read.
      "dependsOn": ["^build", "lint", "typecheck"],
      "env": ["API_URL", "JWT_PUBLIC_KEY"],
      "inputs": ["$TURBO_DEFAULT$", "$TURBO_ROOT$/.env"],
      "outputs": [".next/**", "!.next/cache/**", "!.next/dev/**"]
    },
    "typecheck": {
      "dependsOn": ["^build", "typegen"]
    },
    "lint": {
      "dependsOn": ["^build", "typegen"]
    },
    "test": {
      "dependsOn": ["^build"]
    },
    "dev": {
      "dependsOn": ["^build"],
      "env": ["API_URL", "JWT_PUBLIC_KEY"]
    }
  }
}
